# Shell
command = /bin/bash
shell-integration-features = no-cursor,ssh-env

# Font
font-family = "MesloLGM Nerd Font"
font-size = 11

keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:+1
keybind = ctrl+shift+k=text:\x0c

# Omarchy uses epoll to avoid Ghostty slowness under Hyprland.
async-backend = epoll
